{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentAction",
  "description": "Schema for deterministic Agent Runtime Protocol actions requested by a Coding Agent.",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "OBSERVE",
        "SNAPSHOT",
        "LIST_OBJECTS",
        "INSPECT_OBJECT",
        "INSPECT_FIELD",
        "LIST_MUTATION_CANDIDATES",
        "CHECKPOINT",
        "RESTORE",
        "EXECUTE_TRANSITION",
        "INSPECT_TRANSITION",
        "INSPECT_STATE",
        "LIST_STATES",
        "GET_CAPABILITIES",
        "EXPLORE",
        "STATE_HASH",
        "DETECT_INVARIANTS",
        "MEMORY_SNAPSHOT",
        "ANALYZE_MEMORY_SNAPSHOT",
        "GET_MEMORY_SNAPSHOT",
        "GET_MODULES",
        "GET_SNAPSHOT_PROVENANCE"
      ]
    },
    "snapshot_id": {
      "type": ["string", "null"],
      "description": "Optional target snapshot identifier"
    },
    "object_id": {
      "type": ["string", "null"],
      "description": "Target semantic object identifier (e.g. obj_0001)"
    },
    "field_path": {
      "type": ["string", "null"],
      "description": "Field path inside the target semantic object (e.g. retry)"
    },
    "candidate_id": {
      "type": ["string", "null"],
      "description": "Identifier of a pre-validated MutationCandidate to execute (e.g. M001)"
    },
    "candidate": {
      "type": ["object", "null"],
      "description": "Pre-validated MutationCandidate object to execute"
    },
    "checkpoint_id": {
      "type": ["string", "null"],
      "description": "Checkpoint identifier for restore operations"
    },
    "transition_id": {
      "type": ["string", "null"],
      "description": "Identifier of a StateTransition to inspect (e.g. T001)"
    },
    "state_id": {
      "type": ["string", "null"],
      "description": "Corpus state identifier to inspect (e.g. state_000001)"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000,
      "default": 1000,
      "description": "Execution timeout limit in milliseconds"
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10,
      "description": "Maximum steps for state exploration"
    },
    "max_states": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 20,
      "description": "Maximum states threshold for exploration"
    },
    "corpus_dir": {
      "type": "string",
      "default": "corpus",
      "description": "Corpus storage directory"
    },
    "pid": {
      "type": ["integer", "null"],
      "description": "Target process PID for memory capture"
    },
    "policy": {
      "type": ["string", "null"],
      "enum": ["STACK", "HEAP", "GLOBAL", "EXECUTABLE", "SHARED_LIBRARY", "ALL_READABLE", "SELECTED", null],
      "description": "Memory region selection policy"
    },
    "max_bytes": {
      "type": ["integer", "null"],
      "description": "Maximum memory capture bytes cap"
    },
    "memory_snapshot_id": {
      "type": ["string", "null"],
      "description": "Identifier for raw memory snapshot"
    },
    "debug_image": {
      "type": ["string", "null"],
      "description": "Path to external debug image"
    },
    "mode": {
      "type": ["string", "null"],
      "enum": ["CONSISTENT", "LOW_IMPACT", null],
      "description": "Observation mode"
    }
  },
  "additionalProperties": false
}
