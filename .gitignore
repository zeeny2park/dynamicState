# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C/C++ compiled binaries and objects
*.o
*.obj
*.so
sample
examples/sample_multithread
examples/sample_multithread_nondet
target/collector/dynamicstate-collector

# Temporary build / debug artifacts
.phase*
state.json
tmp_*
corpus/

# Snapshot outputs (preserve directory with .gitkeep)
snapshots/*.json
!snapshots/.gitkeep
